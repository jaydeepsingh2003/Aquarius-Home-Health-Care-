# =================================================================
# Aquarius Home Health Care — Production Environment Variables
# Add these in Vercel Dashboard: Project Settings > Environment Variables
# =================================================================

# 1. SMTP Server Host (Microsoft 365 / GoDaddy Outlook default)
SMTP_HOST=smtp.office365.com

# 2. SMTP Port (587 for STARTTLS)
SMTP_PORT=587

# 3. SMTP Secure (false for port 587 STARTTLS)
SMTP_SECURE=false

# 4. SMTP Username / Authenticated Sender
SMTP_USER=raj.manvi@aquariushomehealth.com

# 5. SMTP Password (Enter your email password or Microsoft App Password here in Vercel)
SMTP_PASS=your_smtp_password_here

# 6. Recipient Email for Live Shift & Inquiry Notifications
NOTIFICATION_EMAIL=raj.manvi@aquariushomehealth.com
